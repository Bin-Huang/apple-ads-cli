{
  "name": "apple-ads-cli",
  "version": "2.0.0",
  "description": "Apple Ads CLI & Skills for AI agents",
  "type": "module",
  "bin": {
    "apple-ads-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "!skills/*/references/local.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"build-test/test/**/*.test.js\"",
    "test:live": "tsc -p tsconfig.test.json && APPLE_ADS_LIVE=1 node --test build-test/test/live.smoke.js",
    "clean": "rm -rf dist build-test",
    "prepack": "npm run build"
  },
  "author": "Benn Huang <tohuangbin@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bin-Huang/apple-ads-cli.git"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "apple-ads",
    "apple-search-ads",
    "ads",
    "cli",
    "ai-agent",
    "api"
  ],
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "bugs": {
    "url": "https://github.com/Bin-Huang/apple-ads-cli/issues"
  },
  "homepage": "https://github.com/Bin-Huang/apple-ads-cli#readme"
}
